# adricamente.com
# -----------------------------------------------------------------
# Esto lo lee el servidor de Hostinger en cada petición. Tres cosas:
# una sola dirección para la web, compresión, y caché para lo que
# no cambia nunca.

# --- Una sola dirección ------------------------------------------
# Sin esto, adricamente.com y www.adricamente.com son dos webs
# distintas para Google y se reparten la autoridad entre las dos.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.adricamente\.com$ [NC]
  RewriteRule ^(.*)$ https://adricamente.com/$1 [R=301,L]
</IfModule>

# --- Compresión ---------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caché --------------------------------------------------------
# Las fuentes y las imágenes no cambian nunca: un año, y que el
# navegador ni pregunte. El HTML, en cambio, tiene que poder
# cambiar hoy, así que se revalida siempre.
# El CSS lleva ?v=N en la URL, así que también puede cachearse
# fuerte: cuando cambia, cambia el número y es otra dirección.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|jpg|jpeg|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Página de error propia ---------------------------------------
ErrorDocument 404 /404.html
