# Carpeta temporal de trabajo.
#
# Contiene el HTML de los correos para poder cargarlo en Brevo sin
# tener que copiarlo y pegarlo a mano. Dos cabeceras:
#
#   Access-Control-Allow-Origin  deja que el panel de Brevo lea
#                                estos archivos desde su propia
#                                página. Sin esto el navegador lo
#                                bloquea por seguridad.
#   X-Robots-Tag                 que no lo indexe ningún buscador.
#
# En cuanto los correos estén cargados, esta carpeta se borra.
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Content-Type "text/plain; charset=utf-8"
</IfModule>
